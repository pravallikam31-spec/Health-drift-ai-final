# Food recognition Flask backend URL
# Leave empty for default automatic resolution:
# - In web browsers: uses same-origin proxy '/api/predict' -> forwards to FLASK_BACKEND_URL
# - On Android emulator: defaults to http://10.0.2.2:5000/predict
# - Custom / physical device: e.g. http://192.168.1.45:5000/predict or https://your-server/predict
VITE_FOOD_RECOGNITION_API_URL=
FLASK_BACKEND_URL=http://127.0.0.1:5000

# Server-only Gemini API key; never prefix this secret with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Server-side project ID used to verify Firebase ID tokens; never prefix server secrets with VITE_.
FIREBASE_PROJECT_ID=health-drift-ai

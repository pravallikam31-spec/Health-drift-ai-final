<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#663B82F6">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/sleep_primary_blue"
                android:endColor="@color/sleep_electric_cyan" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/sleep_text_primary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
